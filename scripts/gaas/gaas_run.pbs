#!/bin/bash
# NTU GaaS H200, 11-17 20:05 (user approved: plan v13 E5 ar2_clock and E7 ar2_long train here; IDENTICAL to the old
# H200 at 19:32). One job = one run of scripts/gaas/gaas_queue.txt on one GPU (two such jobs = the user's "2 GPUs at a
# time"). Submitted by fetch_2task.sh when the run's data is here, or by hand:
#   cd ~/mwam && qsub -v RUN=ar2_clock FastWAM-memory2/scripts/gaas/gaas_run.pbs
# Steps (stops at the first failure, reason in the log):
#   1 container exactly as in setup_parity.pbs (the way that passed IDENTICAL): APPTAINER_HOME unset, --cleanenv + env
#     file, PYTHONNOUSERSITE=1, the SIF unpacked once into node-local /tmp, binds to the old H200's paths; pip freeze
#     sha256 must be the old H200's; unit tests
#   2 data checks, once (markers): the two-task cache against the payload MANIFEST with sha256 (.verified); a run's own
#     task cache from the cache relay (11-18: cover_ar, ranking_ar) against its RELAY_MANIFEST (.verified); for ar2_long
#     the resume parts against parts.sha256, joined, the whole file against resume.pt.sha256 (.resume_verified); for
#     ar2_clock READY_e5 = ledger_ready.py --variant arclk on put / swap (no GPU visible to it)
#   3 the line's condition, then the trainer (base_2task.yaml + the line's sets, micro 8 x 8 as on the old H200), with
#     export_watch.sh (exports to the relay for the A40) beside it; one resumed retry in the same job
#   4 45 min before the walltime: <run>/STOP (the trainer saves resume.pt and exits) and the job resubmits itself (or
#     says how); the next job resumes from resume.pt
# After the run: waits (up to 2 h) for the last export to reach the relay, then ends (the GPU goes back to the pool).
# Logs: ~/mwam/logs/RUN_<run>_<time>.txt ; trainer: outputs/fullft/QUEUE_<run>.log
#PBS -N mwam_run
#PBS -P gs_ccds_tianwei.zhang
#PBS -q gpu_as
#PBS -l select=1:ncpus=12:ngpus=1:mem=200gb
#PBS -l walltime=96:00:00
#PBS -j oe
set -u
W=$HOME/mwam
R=$W/FastWAM-memory2
# 11-19 (plan v15): PBS runs the copy of this file made at qsub time; jobs queued days ahead (E24 / E25 behind cover_ar)
# should run the repository's current version instead: pull once, then hand over to it (MWAM_REEXEC guards the loop).
if [ "${MWAM_REEXEC:-0}" != 1 ]; then
  (cd $R && git pull -q --ff-only origin memory2) > /dev/null 2>&1
  export MWAM_REEXEC=1
  [ -f $R/scripts/gaas/gaas_run.pbs ] && exec bash $R/scripts/gaas/gaas_run.pbs "$@"
fi
HFPY=$W/envs/hf-tools/bin/python
SIF=$W/sif/pytorch_25.11_417cbf33.sif
FREEZE_SHA=2707a91e446b2327fb3a9d695d86dc87fe3d8f41d3c29069d87d4270701b4607
RUN=${RUN:?submit with qsub -v RUN=<run>}
F=$R/outputs/fullft
# 11-25 (user 14:08: every machine syncs its results like the A40): while this job lives, push a results snapshot to the
# branch results-h200n at most every 25 min (one pusher at a time across our jobs: lock directory on the shared home;
# the token was stored once by the user: ~/mwam/results_push/.git/credentials). Nothing runs on the login node.
if [ -s $W/results_push/.git/credentials ] && [ "${MWAM_PUSHER:-0}" != 1 ]; then
  export MWAM_PUSHER=1                            # once per job (the slot wait re-executes this file in the same process)
  (
    while kill -0 $$ 2>/dev/null; do
      L=$W/results_push.lock S=$W/results_push/LAST_PUSH
      if [ -d $L ] && [ $(( $(date +%s) - $(stat -c %Y $L) )) -gt 1200 ]; then rmdir $L 2>/dev/null; fi
      if { [ ! -f $S ] || [ $(( $(date +%s) - $(stat -c %Y $S) )) -ge 1500 ]; } && mkdir $L 2>/dev/null; then
        MACHINE=h200n R=$R W=$W/results_push timeout 900 bash $R/scripts/fullft/results_push.sh once > /dev/null 2>&1 && touch $S
        rmdir $L 2>/dev/null
      fi
      sleep 300
    done
  ) > /dev/null 2>&1 &
fi
# 11-24 plan v20 (Opus): helpers shared by slot jobs and plain runs. qline: the run's line of gaas_queue.txt.
# prepare_data: fetch, inside the job, what the line needs and is not here yet (no programs on the login node):
#   * data.roots dense_<task>_v1 from the cache relay (cache_relay.py get = download + sha256 of every file against its
#     RELAY_MANIFEST + cache markers); a folder already here but not verified is verified; -> .verified
#   * data.events files: events_<task>_v3c.json / _v3a.json from the relay prefix diag/<task>_<tag> (task_v3c_events.py --relay on the
#     5090); events_<task>.json of the B1 tasks from diag/events_b1 (as fetch_b3.sh); an existing file is never replaced
# Returns 1 (with the reason in the log) when something cannot be fetched.
qline() { grep -v '^[[:space:]]*#' $R/scripts/gaas/gaas_queue.txt | awk -F'|' -v r="$1" '{x = $1; gsub(/[[:space:]]/, "", x)} x == r'; }
prepare_data() {
  local run=$1 sets root D ev E stem task IN
  sets=$(qline "$run" | cut -d'|' -f2)
  for root in $(echo "$sets" | grep -o 'data.roots=\[[^]]*\]' | sed 's/data.roots=\[//; s/\]//' | tr ',' ' '); do
    case "$root" in /workspace/FastWAM-memory2/outputs/memory_v2/press/dense_*) ;; *) continue;; esac
    D=$R/${root#/workspace/FastWAM-memory2/}
    [ -f $D/.verified ] && continue
    if [ -d $D ] && [ -f $D/RELAY_MANIFEST.json ]; then
      echo "[prep] $(date '+%F %T') $run: verifying $(basename $D) (here, not verified yet)"
      $HFPY $R/scripts/fullft/cache_relay.py verify $D 2>&1 | tail -n 3
      [ ${PIPESTATUS[0]} -eq 0 ] || { echo "[prep] $run: $(basename $D) sha256 check FAILED"; return 1; }
    else
      echo "[prep] $(date '+%F %T') $run: fetching $(basename $D) from the cache relay (home $(df -h $HOME | tail -n 1 | awk '{print $4}') free)"
      (cd $R && HF_HUB_DOWNLOAD_TIMEOUT=60 $HFPY scripts/fullft/cache_relay.py get --name $(basename $D) --dest $(dirname $D) 2>&1 | tail -n 4; exit ${PIPESTATUS[0]})
      [ $? -eq 0 ] || { echo "[prep] $run: $(basename $D) not fetched / not verified (not on the cache relay?)"; return 1; }
    fi
    touch $D/.verified && echo "[prep] $run: $(basename $D) verified ($(du -sh $D | cut -f1))"
  done
  for ev in $(echo "$sets" | grep -o 'data.events=\[[^]]*\]' | sed 's/data.events=\[//; s/\]//' | tr ',' ' '); do
    E=$R/${ev#/workspace/FastWAM-memory2/}
    [ -s $E ] && continue
    stem=$(basename $E .json); task=${stem#events_}
    mkdir -p $(dirname $E)
    case "$stem" in
      *_v3[a-z]) IN=$F/relay_in/${task}; mkdir -p $IN
             (cd $R && HF_HUB_DOWNLOAD_TIMEOUT=60 $HFPY scripts/memory_v2/migrate/relay.py get --prefix diag/${task} --out $IN 2>&1 | grep "\[relay\]" | tail -n 2) ;;
      *)     IN=$F/relay_in/events_b1; mkdir -p $IN
             (cd $R && HF_HUB_DOWNLOAD_TIMEOUT=60 $HFPY scripts/memory_v2/migrate/relay.py get --prefix diag/events_b1 --out $IN 2>&1 | grep "\[relay\]" | tail -n 2) ;;
    esac
    [ -s $IN/$stem.json ] || { echo "[prep] $run: $stem.json is not on the relay"; return 1; }
    cp $IN/$stem.json $E && echo "[prep] $run: $stem.json fetched ($(stat -c %s $E) bytes, sha256 $(sha256sum $E | cut -c1-16))"
  done
  # 11-24 plan v20 card 7: data.zoom_root (match_build_5090.sh -> the cache relay), fetched here so a missing cache
  # makes the run not ready (the slot passes to its next candidate) instead of failing the job
  ev=$(echo "$sets" | grep -o 'data.zoom_root=[^ ]*' | sed 's/data.zoom_root=//')
  if [ -n "$ev" ]; then
    E=$R/${ev#/workspace/FastWAM-memory2/}
    if [ ! -f $E/ZOOM.json ]; then
      (cd $R && HF_HUB_DOWNLOAD_TIMEOUT=60 $HFPY scripts/fullft/cache_relay.py get --name $(basename $E) --dest $(dirname $E) 2>&1 | tail -n 3)
      [ -f $E/ZOOM.json ] || { echo "[prep] $run: zoom cache $(basename $E) is not on the cache relay"; return 1; }
      echo "[prep] $run: zoom cache $(basename $E) fetched ($(du -sh $E | cut -f1))"
    fi
  fi
  # 11-24 plan v20 card 5: data.text_table (press_told_text.py on the 5090 -> relay diag/press_told)
  ev=$(echo "$sets" | grep -o 'data.text_table=[^ ]*' | sed 's/data.text_table=//')
  if [ -n "$ev" ]; then
    E=$R/${ev#/workspace/FastWAM-memory2/}
    if [ ! -s $E ]; then
      IN=$F/relay_in/press_told; mkdir -p $IN $(dirname $E)
      (cd $R && HF_HUB_DOWNLOAD_TIMEOUT=60 $HFPY scripts/memory_v2/migrate/relay.py get --prefix diag/press_told --out $IN 2>&1 | grep "\[relay\]" | tail -n 2)
      [ -s $IN/$(basename $E) ] || { echo "[prep] $run: $(basename $E) is not on the relay"; return 1; }
      want=$(grep -o '"pt_sha256": "[0-9a-f]*"' $IN/TOLD_TEXT.json 2>/dev/null | cut -d'"' -f4)
      got=$(sha256sum $IN/$(basename $E) | cut -d' ' -f1)
      [ -n "$want" ] && [ "$want" = "$got" ] || { echo "[prep] $run: text table sha256 $got != TOLD_TEXT.json's '$want'"; return 1; }
      cp $IN/$(basename $E) $E && cp $IN/TOLD_TEXT.json $(dirname $E)/ && echo "[prep] $run: text table fetched (sha256 ${got:0:16})"
    fi
  fi
  return 0
}
# Slot job (RUN=@<slot>, plan v20 2.4a): pick the first ready run of the slot's list (scripts/gaas/slots.txt).
if [ "${RUN#@}" != "$RUN" ]; then
  SLOT=${RUN#@}
  mkdir -p $W/logs
  PLOG=$W/logs/PICK_${SLOT}_$(date +%Y%m%d_%H%M).txt
  {
    echo "[pick] $(date '+%F %T') slot $SLOT; job ${PBS_JOBID:-none}; code $(cd $R && git log --oneline -1 | cut -c1-60)"
    CANDS=$(grep -v '^[[:space:]]*#' $R/scripts/gaas/slots.txt | awk -F'|' -v s="$SLOT" '{x = $1; gsub(/[[:space:]]/, "", x)} x == s {print $2}')
    PICKED=""
    for c in $CANDS; do
      [ -n "$(qline $c)" ] || { echo "[pick] $c: no line in gaas_queue.txt yet"; continue; }
      [ -f $R/scripts/gaas/go/$c ] || { echo "[pick] $c: no go file yet"; continue; }
      if [ -s $R/scripts/gaas/go/$c ] && ! (cd $R && bash $R/scripts/gaas/go/$c) > /dev/null 2>&1; then
        echo "[pick] $c: go test not met ($(head -c 160 $R/scripts/gaas/go/$c))"; continue; fi
      [ -f $F/$c/SUMMARY.json ] && { echo "[pick] $c: finished already"; continue; }
      cj=$(cat $F/$c/.claimed_by 2>/dev/null)
      if [ -n "$cj" ] && [ "$cj" != "${PBS_JOBID:-none}" ] && qstat "$cj" 2>/dev/null | grep -q " R "; then
        echo "[pick] $c: running in job $cj"; continue; fi
      mkdir -p $F/$c
      if prepare_data $c; then PICKED=$c; echo "${PBS_JOBID:-none}" > $F/$c/.claimed_by; break; fi
      echo "[pick] $c: data not ready -> next candidate"
    done
    echo "[pick] $(date '+%F %T') slot $SLOT -> ${PICKED:-NOTHING}"
  } 2>&1 | tee -a $PLOG
  PICKED=$(grep -o 'slot [A-Za-z0-9]* -> [A-Za-z0-9_]*' $PLOG | tail -n 1 | awk '{print $4}')
  if [ -z "$PICKED" ] || [ "$PICKED" = NOTHING ]; then
    # 11-25 (unattended until Friday): a chained slot that ends at once would pass the GPU down a chain of empty jobs;
    # it looks again every 15 min (new code pulled first) for up to SLOT_WAIT_H hours (default 3), then ends
    WAITED=${WAITED:-0}
    if [ $WAITED -lt $(( ${SLOT_WAIT_H:-3} * 4 )) ]; then
      echo "[pick] nothing ready for slot $SLOT: looking again in 15 min ($WAITED / $(( ${SLOT_WAIT_H:-3} * 4 )))" | tee -a $PLOG
      sleep 900
      (cd $R && git pull -q --ff-only origin memory2) > /dev/null 2>&1
      export WAITED=$((WAITED + 1)) MWAM_REEXEC=1
      exec bash $R/scripts/gaas/gaas_run.pbs "$@"
    fi
    echo "[pick] nothing ready for slot $SLOT after ${SLOT_WAIT_H:-3} h: the job ends (GPU back to the pool); see $PLOG"; exit 0
  fi
  RUN=$PICKED
  NO_RESUBMIT=1                                   # slot jobs are chained (submit_v20.sh): never add a job of their own
  # AUTO_CLEAN (user 11-22): on, unless another line seeds from this run's resume.pt (schedule.resume_from)
  if grep -v '^[[:space:]]*#' $R/scripts/gaas/gaas_queue.txt | grep -q "schedule.resume_from=[^ ]*/outputs/fullft/$RUN/resume.pt"; then
    AUTO_CLEAN=0; else AUTO_CLEAN=1; fi
  export RUN NO_RESUBMIT AUTO_CLEAN
  WALL_H=${WALL_H:-96}
fi
WALL_H=${WALL_H:-96}
C=$W/hf/payload/workspace/FastWAM/outputs/s1_dense_joint_h100_v1
mkdir -p $W/logs $F/$RUN
LOG=$W/logs/RUN_${RUN}_$(date +%Y%m%d_%H%M).txt
exec > >(tee -a "$LOG") 2>&1
step() { echo "[run] $(date '+%F %T') $*"; }
fail() { echo "[run] $(date '+%F %T') FAILED: $*"; { echo "$(date '+%F %T') job ${PBS_JOBID:-none}: $*"; } >> $F/$RUN/GAAS_FAILED; exit 1; }
step "run $RUN; host $(hostname); job ${PBS_JOBID:-none}; cores $(nproc); CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
nvidia-smi -L
cd $R
git pull -q --ff-only origin memory2 || step "git pull skipped (another job pulling?)"
step "code $(git log --oneline -1 | cut -c1-70)"
echo "${PBS_JOBID:-none}" > $F/$RUN/GAAS_JOB
[ -f $F/$RUN/SUMMARY.json ] && { step "$RUN has finished already: nothing to do"; exit 0; }
if [ "$RUN" = relay_backlog ]; then              # 11-21: upload-only job (no training), see below
  LINE="relay_backlog | | true"
else
LINE=$(grep -v '^[[:space:]]*#' scripts/gaas/gaas_queue.txt | awk -F'|' -v r="$RUN" '{x = $1; gsub(/[[:space:]]/, "", x)} x == r')
[ -n "$LINE" ] || fail "no line $RUN in scripts/gaas/gaas_queue.txt"
fi
SETS=$(echo "$LINE" | cut -d'|' -f2 | xargs)
COND=$(echo "$LINE" | cut -d'|' -f3- | xargs)
read -r -a SETA <<< "$SETS"                      # no glob expansion of values like [45,60]
A=(--set "name=$RUN"); for s in "${SETA[@]}"; do A+=(--set "$s"); done
step "sets: $SETS"
# 11-21 15:10: the cluster no longer has the module apptainer/1.4.1 ("Unable to locate a modulefile", login node and
# g13 / g14; apptainer not on PATH). Try, in order: that module, any apptainer / singularity module (newest), the
# install the old module pointed to (/usr/local/apptainer/<version>/bin), then a plain PATH. Stop with the module list.
module purge
# 11-21 15:04 (login node): /usr/local/apptainer/1.4.1 and /usr/local/modulefiles still exist; MODULEPATH no longer
# lists /usr/local/modulefiles (now: /etc/scl/modulefiles:/usr/share/Modules/modulefiles:/etc/modulefiles:...).
[ -d /usr/local/modulefiles ] && module use /usr/local/modulefiles
APPT_HOW=""
for m in apptainer/1.4.1 $(module -t avail 2>&1 | grep -iE '^(apptainer|singularity)' | sort -rV); do
  module load "$m" > /dev/null 2>&1 && command -v apptainer > /dev/null && { APPT_HOW="module $m"; break; }
done
if [ -z "$APPT_HOW" ]; then
  for b in $(ls -d /usr/local/apptainer/*/bin /opt/apptainer*/bin /usr/local/singularity/*/bin 2>/dev/null | sort -rV); do
    [ -x $b/apptainer ] && { export PATH=$b:$PATH; APPT_HOW="path $b"; break; }
  done
fi
[ -z "$APPT_HOW" ] && command -v apptainer > /dev/null && APPT_HOW="on PATH $(command -v apptainer)"
[ -n "$APPT_HOW" ] || fail "no apptainer on $(hostname): modules [$(module -t avail 2>&1 | tr '\n' ' ' | cut -c1-300)]; /usr/local: [$(ls /usr/local 2>/dev/null | tr '\n' ' ')]"
step "apptainer: $APPT_HOW ($(apptainer --version 2>&1 | head -n 1))"
unset APPTAINER_HOME SINGULARITY_HOME          # the module's APPTAINER_HOME would become the container's HOME

step "1 container, environment, unit tests"
SBXDIR=/tmp/mwam_sbx_${PBS_JOBID:-$$}
SBX=$SBXDIR
trap 'rm -rf "$SBXDIR"' EXIT                    # the job's own unpacked image on the node's local disk (never the SIF)
# 11-21 (plan v18): every job started after 11-21 01:49 failed here with the error thrown away. Now: the node's free
# space and the build's own error go to the log; if the sandbox cannot be built, run the SIF directly (no unpack).
step "node $(hostname): /tmp $(df -h /tmp 2>/dev/null | tail -n 1 | awk '{print $4}') free; home $(df -h $HOME 2>/dev/null | tail -n 1 | awk '{print $4}') free"
SBXLOG=$W/logs/sbx_${PBS_JOBID:-$$}.txt
if ! apptainer build --sandbox "$SBXDIR" "$SIF" > $SBXLOG 2>&1; then
  step "sandbox build failed: $(grep -iE 'error|fatal|no space|quota|denied' $SBXLOG | tail -n 3 | tr '\n' ' ' | cut -c1-400)"
  rm -rf "$SBXDIR"
  SBX=$SIF
  apptainer exec "$SIF" true >> $SBXLOG 2>&1 || fail "sandbox from the SIF, and the SIF itself does not run ($SBXLOG)"
  step "running the SIF directly (no sandbox)"
fi
B="$R:/workspace/FastWAM-memory2,$W/hf/payload/workspace/FastWAM:/workspace/FastWAM,$W/envs/mwam:/opt/mwam"
EF=$W/logs/container_env_${PBS_JOBID:-$$}.txt
printf '%s\n' "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-}" PYTHONNOUSERSITE=1 \
  PYTHONPATH=/workspace/FastWAM-memory2/src PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True OMP_NUM_THREADS=8 > $EF
X() { apptainer exec --nv --cleanenv --bind "$B" --pwd /workspace/FastWAM-memory2 --env-file "$EF" "$SBX" "$@"; }
if [ "$RUN" = relay_backlog ]; then
  # 11-21 23:45 (user: do not restart a training job): exports that missed the HF relay while it was full
  # (scripts/gaas/relay_backlog.txt: press_clock e10-e30, ranking_ar e30) go up from this short job once a GPU slot of
  # the group is free. Submit: qsub -l select=1:ncpus=4:ngpus=1:mem=32gb -l walltime=03:00:00 -v RUN=relay_backlog ...
  step "relay backlog only (no training): $(grep -v '^#' scripts/gaas/relay_backlog.txt | tr '\n' ';')"
  X bash -c "bash scripts/fullft/relay_backlog.sh"
  step "relay backlog: $(tail -n 2 $(ls -t $F/RELAY_BACKLOG_*.txt | head -1) | tr '\n' ' ')"
  for r in press_clock ranking_ar; do step "$r relayed: $(ls $F/$r/.relayed_* 2>/dev/null | xargs -n1 basename | tr '\n' ' ')"; done
  step "done"
  exit 0
fi
GOT=$(X /opt/mwam/bin/python -m pip freeze 2>/dev/null | sha256sum | cut -c1-64)
[ "$GOT" = "$FREEZE_SHA" ] || fail "pip freeze sha256 $GOT is not the old H200's $FREEZE_SHA"
X /opt/mwam/bin/python -c "import torch; p = torch.cuda.get_device_properties(0); print('[run]', torch.__version__, torch.cuda.get_device_name(0), 'SMs', p.multi_processor_count)"
X /opt/mwam/bin/python -m pytest -q -p no:cacheprovider src/fastwam/fullft/tests 2>&1 | tail -n 2
[ ${PIPESTATUS[0]} -eq 0 ] || fail "unit tests"

step "2 data checks"
prepare_data $RUN || fail "data of $RUN could not be fetched (see [prep] above)"
if [ ! -f $C/.verified ]; then
  $HFPY scripts/memory_v2/migrate/manifest.py verify --manifest $W/hf/MANIFEST.json --root $W/hf \
    --prefix /workspace/FastWAM/outputs/s1_dense_joint_h100_v1/cache /workspace/FastWAM/outputs/s1_dense_joint_h100_v1/RECORDS.json \
    2>&1 | tail -n 3
  [ ${PIPESTATUS[0]} -eq 0 ] || fail "two-task cache sha256 against the MANIFEST"
  touch $C/.verified
fi
step "two-task cache verified ($(du -sh $C | cut -f1))"
for root in $(echo "$SETS" | grep -o 'data.roots=\[[^]]*\]' | sed 's/data.roots=\[//; s/\]//' | tr ',' ' '); do
  case "$root" in /workspace/FastWAM-memory2/outputs/memory_v2/press/dense_*) ;; *) continue;; esac
  D=$R/${root#/workspace/FastWAM-memory2/}       # 11-18: a task cache from the cache relay (fetch_b1.sh), once
  [ -f $D/.verified ] && { step "cache $(basename $D) verified before"; continue; }
  [ -d $D ] || fail "no cache folder $D (fetch_b1.sh on the login node first)"
  $HFPY scripts/fullft/cache_relay.py verify $D 2>&1 | tail -n 4
  [ ${PIPESTATUS[0]} -eq 0 ] || fail "cache $(basename $D): sha256 against its RELAY_MANIFEST"
  touch $D/.verified
  step "cache $(basename $D) verified ($(du -sh $D | cut -f1))"
done
# 11-22 plan v19 A3: zoom latents (data.zoom_root) come from the cache relay (zoom_build_5090.sh), fetched here once
ZR=$(echo "$SETS" | grep -o 'data.zoom_root=[^ ]*' | sed 's/data.zoom_root=//')
if [ -n "$ZR" ]; then
  ZD=$R/${ZR#/workspace/FastWAM-memory2/}
  if [ ! -f $ZD/ZOOM.json ]; then
    HF_HUB_DOWNLOAD_TIMEOUT=60 $HFPY scripts/fullft/cache_relay.py get --name $(basename $ZD) --dest $(dirname $ZD) 2>&1 | tail -n 3
    [ -f $ZD/ZOOM.json ] || fail "zoom latents $(basename $ZD) not on the cache relay (run zoom_build_5090.sh on the 5090)"
  fi
  step "zoom latents $(basename $ZD) here ($(du -sh $ZD | cut -f1))"
fi
# 11-22: all ten jobs died at 05:21 when the home disk filled (two new runs wrote their first resume.pt, about 72 GB
# each, next to the four older ones) [inferred]. A run needs room for one more resume.pt while it saves (.partial,
# then the old one is replaced): wait until the home has >= 160 GB free (up to 6 h). Nothing is deleted here.
for i in $(seq 1 36); do
  free=$(df -BG --output=avail $HOME | tail -n 1 | tr -dc '0-9')
  [ "${free:-0}" -ge 160 ] && break
  [ $i = 36 ] && fail "home has ${free} GB free after 6 h (< 160 GB needed for a resume checkpoint)"
  step "home has ${free} GB free (< 160 GB); waiting 10 min"; sleep 600
done
step "home ${free} GB free"
if [ "$RUN" = ar2_long ] && [ ! -f $F/ar_2task/.resume_verified ]; then
  D=$W/dl/ar_2task_e30/ckpt/ar_2task_e30
  (cd $D && sha256sum -c --quiet parts.sha256) || fail "resume parts sha256"
  mkdir -p $F/ar_2task
  cat $(cd $D && awk '{print $2}' parts.sha256 | sort | sed "s#^#$D/#") > $F/ar_2task/resume.pt.tmp || fail "joining the parts"
  mv $F/ar_2task/resume.pt.tmp $F/ar_2task/resume.pt
  (cd $F/ar_2task && sha256sum -c --quiet $D/resume.pt.sha256) || fail "the joined resume.pt differs from the old H200's"
  touch $F/ar_2task/.resume_verified
  step "ar_2task/resume.pt joined, sha256 = the old H200's: $(cut -c1-16 $D/resume.pt.sha256)..."
fi
if [ "$RUN" = ar2_clock ] && [ ! -f $F/READY_e5 ]; then
  X bash -c "CUDA_VISIBLE_DEVICES= /opt/mwam/bin/python scripts/fullft/ledger_ready.py --variant arclk \
    --tasks put_back_block swap_blocks --marker READY_e5 --skip-tests" 2>&1 | tail -n 6
  [ -f $F/READY_e5 ] || fail "READY_e5 (ledger_ready.py above)"
fi
# 11-19 plan v15 E24: any other clock run (history.variant=arclk) gets READY_<run> on this machine's data: the last
# event_max text slots are padding in every episode (the clock tokens are written there); no event file needed.
if [ "$RUN" != ar2_clock ] && echo " $SETS " | grep -q ' history.variant=arclk ' && [ ! -f $F/READY_$RUN ]; then
  TASKS=$(echo "$SETS" | grep -o 'data.tasks=\[[^]]*\]' | sed 's/data.tasks=\[//; s/\]//' | tr ',' ' ')
  X bash -c "CUDA_VISIBLE_DEVICES= /opt/mwam/bin/python scripts/fullft/ledger_ready.py --variant arclk \
    --tasks ${TASKS:-put_back_block swap_blocks} --no-events --marker READY_$RUN --skip-tests" 2>&1 | tail -n 6
  [ -f $F/READY_$RUN ] || fail "READY_$RUN (ledger_ready.py above)"
fi

# 11-20 plan v16 (user 19:12: line A after ranking_ar trains cover's ledger version): any ledger run (history.variant=arprop)
# gets READY_arprop_<task> here, CPU only, from the events file fetch_b3.sh put in outputs/fullft/events; cover and
# rearrange use deviation 44's --check3 subset (rule A's 3 cm debounce drops real grasps there; alignment only).
# 11-21 plan v18 N1 (training-seed replicates of press_count): a run whose data.events names another file than
# events_<task>.json (press_count's fast writer: events_press_button_fast.json, fetch_b4.sh) is checked on THAT file,
# marker READY_arprop_<file stem>; runs with the default file keep the block below unchanged.
EVF=$(echo "$SETS" | grep -o 'data.events=\[[^],]*\]' | sed 's/data.events=\[//; s/\]//')
if [ -n "$EVF" ] && echo " $SETS " | grep -q ' history.variant=arprop '; then
  T=$(echo "$SETS" | grep -o 'data.tasks=\[[^]]*\]' | sed 's/data.tasks=\[//; s/\]//')
  STEM=$(basename "$EVF" .json)
  if [ "$STEM" != "events_$T" ] && [ ! -f $F/READY_arprop_$STEM ]; then
    [ -s $R/${EVF#/workspace/FastWAM-memory2/} ] || fail "no events file $EVF (fetch_b4.sh first)"
    # 11-24 plan v20: the line's record size (ranking 69) and, for cover / rearrange, deviation 44's --check3 subset
    EMX=$(echo " $SETS " | grep -o ' history.event_max=[0-9]*' | cut -d= -f2); c3=""
    case "$T" in cover_blocks|rearrange_blocks) c3="--check3 subset";; esac
    X bash -c "CUDA_VISIBLE_DEVICES= /opt/mwam/bin/python scripts/fullft/ledger_ready.py --variant arprop --tasks $T \
      --events $EVF --event-max ${EMX:-32} $c3 --marker READY_arprop_$STEM --skip-tests" 2>&1 | tail -n 6
    [ -f $F/READY_arprop_$STEM ] || fail "READY_arprop_$STEM (ledger_ready.py above)"
  fi
  [ "$STEM" != "events_$T" ] && SKIP_DEFAULT_EVENTS=1
fi
# 11-24 plan v20 (ar2_v3c): several events files, at least one not the task's default events_<task>.json -> each is
# checked against its own task (task = the file stem without "events_" and a "_v3c" ending), marker READY_arprop_<stem>.
EVS=$(echo "$SETS" | grep -o 'data.events=\[[^]]*,[^]]*\]' | sed 's/data.events=\[//; s/\]//' | tr ',' ' ')
if [ -n "$EVS" ] && echo " $SETS " | grep -q ' history.variant=arprop ' && echo "$EVS" | grep -q '_v3c\.json'; then
  EMX=$(echo " $SETS " | grep -o ' history.event_max=[0-9]*' | cut -d= -f2)
  for EV in $EVS; do
    STEM=$(basename "$EV" .json); T=${STEM#events_}; T=${T%_v3c}
    [ -f $F/READY_arprop_$STEM ] && continue
    [ -s $R/${EV#/workspace/FastWAM-memory2/} ] || fail "no events file $EV"
    c3=""; case "$T" in cover_blocks|rearrange_blocks) c3="--check3 subset";; esac
    X bash -c "CUDA_VISIBLE_DEVICES= /opt/mwam/bin/python scripts/fullft/ledger_ready.py --variant arprop --tasks $T \
      --events $EV --event-max ${EMX:-32} $c3 --marker READY_arprop_$STEM --skip-tests" 2>&1 | tail -n 6
    [ -f $F/READY_arprop_$STEM ] || fail "READY_arprop_$STEM (ledger_ready.py above)"
  done
  SKIP_DEFAULT_EVENTS=1
fi
if echo " $SETS " | grep -q ' history.variant=arprop ' && [ "${SKIP_DEFAULT_EVENTS:-0}" != 1 ]; then
  for T in $(echo "$SETS" | grep -o 'data.tasks=\[[^]]*\]' | sed 's/data.tasks=\[//; s/\]//' | tr ',' ' '); do
    [ -f $F/READY_arprop_$T ] && continue
    [ -s $F/events/events_$T.json ] || fail "no events file outputs/fullft/events/events_$T.json (fetch_b3.sh first)"
    c3=""; case "$T" in cover_blocks|rearrange_blocks) c3="--check3 subset";; esac
    X bash -c "CUDA_VISIBLE_DEVICES= /opt/mwam/bin/python scripts/fullft/ledger_ready.py --variant arprop --tasks $T \
      --marker READY_arprop_$T --skip-tests $c3" 2>&1 | tail -n 6
    [ -f $F/READY_arprop_$T ] || fail "READY_arprop_$T (ledger_ready.py above)"
  done
fi

step "3 condition and training"
[ "${AUTO_CLEAN:-0}" = 1 ] && touch $F/$RUN/.auto_clean   # 11-22: lets the relay backlog clean up after a later upload
bash -c "$COND" || fail "condition not met: $COND"
( sleep $(( WALL_H * 3600 - 2700 )); touch $F/$RUN/STOP; echo "[run] $(date '+%F %T') walltime near: STOP written" ) &
TIMER=$!
X bash -c "RUN=$RUN AUTO_CLEAN=${AUTO_CLEAN:-0} bash scripts/fullft/export_watch.sh" > /dev/null 2>&1 &
WATCH=$!
if [ -s scripts/gaas/relay_backlog.txt ] || [ -s $F/RELAY_PENDING.txt ]; then   # 11-21 / 11-22: exports not yet on the relay
  find $F -maxdepth 1 -name .relay_backlog_lock -mmin +1500 -exec rm -rf {} \; 2>/dev/null
  if [ -d $F/.relay_backlog_lock ] && command -v qstat > /dev/null; then   # 11-22: a lock whose job no longer runs is stale (the job's end can
    lj=$(cat $F/.relay_backlog_lock/job 2>/dev/null)   # kill the backlog before its exit trap removes the lock)
    if [ -z "$lj" ] || ! qstat "$lj" 2>/dev/null | grep -q " R "; then rm -rf $F/.relay_backlog_lock; fi
  fi
  if mkdir $F/.relay_backlog_lock 2>/dev/null; then
    echo "${PBS_JOBID:-none}" > $F/.relay_backlog_lock/job
    X bash -c "bash scripts/fullft/relay_backlog.sh" > /dev/null 2>&1 &
    step "relay backlog started in this job (scripts/gaas/relay_backlog.txt)"
  fi
fi
rc=1
for attempt in 1 2; do
  step "$RUN attempt $attempt"
  X /opt/mwam/bin/python -m fastwam.fullft.train train --config configs/fullft/base_2task.yaml "${A[@]}" >> $F/QUEUE_$RUN.log 2>&1
  rc=$?
  step "trainer exit code $rc; $(grep -a 'u [0-9]*/' $F/QUEUE_$RUN.log | tail -n 1 | cut -c1-160)"
  [ -f $F/$RUN/SUMMARY.json ] && break
  [ -f $F/$RUN/STOP ] && break
  [ $attempt = 1 ] && { step "no SUMMARY.json: one resumed retry in 120 s"; sleep 120; }
done
kill $TIMER 2>/dev/null
if [ -f $F/$RUN/STOP ] && [ ! -f $F/$RUN/SUMMARY.json ]; then
  rm -f $F/$RUN/STOP
  step "stopped before the walltime; $(grep -a 'resume checkpoint saved' $F/QUEUE_$RUN.log | tail -n 1 | cut -c1-120)"
  if [ "${NO_RESUBMIT:-0}" = 1 ]; then         # 11-22: chained jobs (submit_chains.sh) never add a job of their own
    step "chained job (NO_RESUBMIT): not resubmitted; the chain's next job starts now; resume $RUN later from resume.pt"
  elif command -v qsub > /dev/null && J=$(cd $W && qsub -v RUN=$RUN $R/scripts/gaas/gaas_run.pbs); then
    echo "$J" > $F/$RUN/GAAS_JOB; step "resubmitted: job $J (resumes from resume.pt)"
  else
    step "could not resubmit from here: on the login node run  cd ~/mwam && qsub -v RUN=$RUN FastWAM-memory2/scripts/gaas/gaas_run.pbs"
  fi
  exit 0
fi
[ -f $F/$RUN/SUMMARY.json ] || fail "trainer failed twice (exit code $rc; see $F/QUEUE_$RUN.log)"
step "$RUN finished: $(head -c 300 $F/$RUN/SUMMARY.json)"
# 11-22 (user 18:23: do not waste compute): wait at most 30 min (was 2 h) for the last export to reach the relay, so
# the GPU goes to the chain's next job; what is not on the relay by then goes to outputs/fullft/RELAY_PENDING.txt and
# a later job's relay backlog uploads it (and, with .auto_clean, then removes resume.pt and the relayed exports).
for i in $(seq 1 6); do kill -0 $WATCH 2>/dev/null || break; sleep 300; done
pend=""; for f in $F/$RUN/export_e*.pt; do [ -f "$f" ] || continue; g=$(basename $f .pt); g=${g#export_}
  [ -f $F/$RUN/.relayed_$g ] || pend="$pend $g"; done
if [ -n "$pend" ]; then
  grep -qx "$RUN$pend" $F/RELAY_PENDING.txt 2>/dev/null || echo "$RUN$pend" >> $F/RELAY_PENDING.txt
  step "not on the relay after 30 min:$pend -> RELAY_PENDING.txt (a later job uploads them)"
fi
step "export watcher: $(ls $F/$RUN/.relayed_* 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
# 11-22: AUTO_CLEAN=1 (only when the user approved it for the submission): a finished run's resume.pt (about 72 GB,
# needed only to continue an unfinished run) is removed once SUMMARY.json exists AND its last export is on the relay
# (.relayed_e30, or .relayed_final); otherwise it stays and this says why.
if [ "${AUTO_CLEAN:-0}" = 1 ] && [ -f $F/$RUN/resume.pt ]; then
  if [ -f $F/$RUN/.relayed_e30 ] || [ -f $F/$RUN/.relayed_final ]; then
    sz=$(du -sh $F/$RUN/resume.pt | cut -f1); rm -f $F/$RUN/resume.pt && step "AUTO_CLEAN: removed $RUN/resume.pt ($sz)"
  else
    step "AUTO_CLEAN: resume.pt kept (the last export is not on the relay yet)"
  fi
fi
step "done"
