#!/bin/bash
# NTU GaaS (H200), 11-17 (Opus): step 1 of the environment = the OLD H200's training image, pulled BY DIGEST into an
# apptainer SIF, so the H200s are numerically interchangeable (user 16:57). Old H200 (container mwam2, 16:59):
#   nvcr.io/nvidia/pytorch@sha256:417cbf33f87b5378849df37983552cd1f8bc8b62fe1ceabe004de816a55dff21 (built 2025-11-08)
#   torch 2.10.0a0+b558c986e8.nv25.11, CUDA 13.0, cuDNN 91500, NCCL (2, 28, 8), python 3.12.3
# Pulling and squashing an image is not done on the login node. 11-17 17:06: the datamover queue holds jobs ("too many
# failed attempts to run", every job of that queue held), so it runs as a 1-GPU job of our gpu_as allocation instead
# (command-line options override the #PBS lines below); with a GPU it also prints the GPU seen from inside the SIF.
# Ends by printing the same version line from inside the SIF: it must equal the line above.
#   cd ~/mwam && qsub -q gpu_as -l select=1:ncpus=12:ngpus=1:mem=200gb -l walltime=04:00:00 \
#        FastWAM-memory2/scripts/gaas/sif_pull.pbs                        live log: ~/mwam/logs/SIF_PULL_<time>.txt
#PBS -N mwam_sif
#PBS -P gs_ccds_tianwei.zhang
#PBS -q gpu_datamover
#PBS -l select=1:ncpus=4
#PBS -l walltime=06:00:00
#PBS -j oe
set -u
DIGEST=sha256:417cbf33f87b5378849df37983552cd1f8bc8b62fe1ceabe004de816a55dff21
W=$HOME/mwam
SIF=$W/sif/pytorch_25.11_417cbf33.sif
mkdir -p $W/sif $W/logs $W/.apptainer_cache
LOG=$W/logs/SIF_PULL_$(date +%Y%m%d_%H%M).txt
exec > >(tee -a "$LOG") 2>&1
echo "[sif] $(date '+%F %T') host $(hostname); job ${PBS_JOBID:-none}; cores $(nproc)"
module purge
module load apptainer/1.4.1
echo "[sif] $(apptainer --version)"
printf "[sif] nvcr.io from this node: "; curl -s -o /dev/null -m 15 -w "%{http_code}\n" https://nvcr.io
df -h /tmp $HOME 2>&1 | sed 's/^/[sif] /'
# the squashed image needs about 2x its size of scratch: use /tmp only if it has >= 80 GB free, else a folder in $HOME
FREE=$(df -BG --output=avail /tmp 2>/dev/null | tail -1 | tr -dc '0-9')
if [ "${FREE:-0}" -ge 80 ]; then export APPTAINER_TMPDIR=/tmp/mwam_$$; else export APPTAINER_TMPDIR=$W/tmp; fi
mkdir -p "$APPTAINER_TMPDIR"
export APPTAINER_CACHEDIR=$W/.apptainer_cache
echo "[sif] scratch $APPTAINER_TMPDIR; cache $APPTAINER_CACHEDIR"
if [ -s "$SIF" ]; then
  echo "[sif] $SIF exists: not pulled again"
else
  apptainer pull "$SIF" "docker://nvcr.io/nvidia/pytorch@$DIGEST" || { echo "[sif] PULL FAILED"; exit 1; }
fi
ls -la "$SIF"
(cd $W/sif && sha256sum "$(basename $SIF)" > "$(basename $SIF).sha256" && cat "$(basename $SIF).sha256")
echo "[sif] versions inside the SIF (must equal the old H200 line in this script's header):"
apptainer exec "$SIF" python -c "import sys, torch; print(sys.version.split()[0], torch.__version__, torch.version.cuda, torch.backends.cudnn.version(), torch.cuda.nccl.version())"
if nvidia-smi -L >/dev/null 2>&1; then
  echo "[sif] GPU seen from inside the SIF (--nv); CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}:"
  CUDA_VISIBLE_DEVICES=0 apptainer exec --nv "$SIF" python -c "import torch; p = torch.cuda.get_device_properties(0); print(torch.cuda.get_device_name(0), 'SMs', p.multi_processor_count, 'mem GiB', round(p.total_memory / 2**30, 1), 'cc', torch.cuda.get_device_capability(0), 'bf16', torch.cuda.is_bf16_supported())"
  nvidia-smi --query-gpu=name,driver_version,memory.total,clocks.max.sm --format=csv,noheader
fi
case "$APPTAINER_TMPDIR" in /tmp/mwam_*) rm -rf "$APPTAINER_TMPDIR";; esac
echo "[sif] $(date '+%F %T') done; log $LOG"
